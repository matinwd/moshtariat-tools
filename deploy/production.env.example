# Copy to deploy/production.env and fill from the private ops docs.
# deploy/production.env is gitignored — real values must never be committed.
SSH_HOST=production-host-alias
DOCKER_BIN='$HOME/bin/docker'   # single quotes: expanded on the REMOTE host
TOOLS_EDGE_NETWORK=edge-network-name
PROXY_CONTAINER=edge-proxy-container-name
PROXY_CONF=/path/to/edge-proxy/default.conf
REMOTE_DIR=~/moshtariat-tools
TOOLS_TAG=main
